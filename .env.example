# ═══════════════════════════════════════════════════════════════════════════
# PENTING — dua jenis variabel, jangan tertukar:
#
#   VITE_*        IKUT ke bundle browser. Boleh dibaca siapa pun yang membuka
#                 situs. HANYA untuk nilai yang memang publik.
#   tanpa VITE_   hanya dibaca proses server (server/server.ts). Semua RAHASIA
#                 wajib di sini.
# ═══════════════════════════════════════════════════════════════════════════

# ─── RAHASIA — sisi server saja, tidak pernah ikut ke browser ───────────────

# Kunci Gemini untuk AI Assist. Dipakai server lewat POST /api/ai/chat.
# JANGAN diberi awalan VITE_ — itu akan membocorkannya ke bundle publik.
GEMINI_API_KEY=

# Token bersama untuk semua endpoint yang MENGUBAH state siaran
# (/api/companion/trigger, /animation, /data, /api/telemetry/pubg).
# Kosong = tidak ada pemeriksaan (perilaku lama, hanya aman di jaringan
# studio tertutup). Isi sebelum dipakai di venue atau jaringan publik.
# Kirim dari Companion lewat header X-Brohubs-Key atau query ?key=
BROHUBS_API_KEY=

# Daftar origin yang boleh memanggil /api, dipisah koma.
# Kosong = izinkan semua origin.
# Contoh: http://localhost:3000,https://studio.brohubs.com
BROHUBS_ALLOWED_ORIGINS=

# Alamat bind server. Default 0.0.0.0 supaya Companion/OBS di PC lain bisa
# terhubung. Isi 127.0.0.1 untuk mengunci hanya ke PC ini.
# HOST=127.0.0.1

# ─── Firebase (Firestore) — Langkah 2: sync admin_tasks antar PC/admin ───
# Copy file ini ke .env.local lalu isi dari Firebase Console → Project settings → Web app
# https://console.firebase.google.com

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opsional: paksa provider (default: auto pakai firebase jika config di atas terisi)
# VITE_SERVER_DATA_PROVIDER=local

# ─── Supabase (Projects + gambar) — sync project dari PC mana saja ───
# Buat project gratis di https://supabase.com → Settings → API
# Jalankan SQL di supabase/schema.sql (tabel + bucket storage)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Login pakai username ───
# User cukup mengetik username + password; email tidak perlu.
# "andi" otomatis jadi "andi@brohubs.com" sebelum dikirim ke Supabase.
#
# Supabase mewajibkan identitas berupa email (aturan GoTrue, tidak bisa
# dimatikan), jadi email tetap ada di baliknya — user saja yang tidak perlu
# melihatnya. Username = bagian sebelum "@", jadi keunikannya otomatis dijamin
# keunikan email.
#
# Pemetaannya cuma penggabungan string di browser, nol permintaan ke database,
# jadi tidak ada endpoint yang bisa dipakai menebak-nebak member.
#
# Kosongkan kalau ingin login menuntut email penuh seperti sebelumnya.
VITE_LOGIN_DOMAIN=

# Opsional, DEVELOPMENT SAJA: alias untuk akun yang domainnya menyimpang.
# Format `username:email` dipisah koma. Diperiksa lebih dulu sebelum domain.
# Dikurung `import.meta.env.DEV`, jadi tidak pernah ikut ke bundle produksi.
# VITE_DEV_LOGIN_ALIASES=david:david@mediassassin.com

# RAHASIA — dipakai server (endpoint POST /api/admin/members untuk tombol
# "Add New Member" di dashboard) dan script scripts/create-account.mjs.
# Tidak pernah dibaca bundle browser. Kunci ini melewati SEMUA aturan RLS, jadi
# jangan pernah diberi awalan VITE_ dan jangan di-commit.
# Ambil di Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
